\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 样本量与复杂度控制。每行一个任务，左列使用网格提升树，固定完整外层训练集内选出的参数，增加训练样本比例；每个子样本重新拟合预处理。Adult 以指纹组抽取，NBA 取最早完整赛季，因此其比例是赛季近似值。右列改变决策树深度，叶节点最少两条，Full 表示不限制深度。线与阴影为三折均值及标准差，验证记录保持不变。这些控制用于诊断，不增加排行榜条目。}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:expanded-fit}{{2}{6}{样本量与复杂度控制。每行一个任务，左列使用网格提升树，固定完整外层训练集内选出的参数，增加训练样本比例；每个子样本重新拟合预处理。Adult 以指纹组抽取，NBA 取最早完整赛季，因此其比例是赛季近似值。右列改变决策树深度，叶节点最少两条，Full 表示不限制深度。线与阴影为三折均值及标准差，验证记录保持不变。这些控制用于诊断，不增加排行榜条目。}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 固定四十轮预算下的拟合诊断。颜色区分残差 MLP 与字段 Transformer，虚线为训练、实线为外层验证，阴影为三折标准差。展示模型固定为残差 MLP 与字段 Transformer，不按外层成绩挑选；曲线仅记录，未用于选择轮数或早停。回归损失转换回原目标尺度，分类为对数损失。}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:expanded-training}{{3}{7}{固定四十轮预算下的拟合诊断。颜色区分残差 MLP 与字段 Transformer，虚线为训练、实线为外层验证，阴影为三折标准差。展示模型固定为残差 MLP 与字段 Transformer，不按外层成绩挑选；曲线仅记录，未用于选择轮数或早停。回归损失转换回原目标尺度，分类为对数损失。}{figure.3}{}}
